// The cloud Strata server on Cloudflare Workers (see README.md here).
//   cd deploy/cloudflare
//   npx wrangler secret put DATABASE_URL        # Neon's connection string
//   npx wrangler secret put STRATA_SECRET_KEY   # openssl rand -base64 32 (keep it safe)
//   npx wrangler deploy
// Optional secrets: RESEND_API_KEY (password-reset email), GOOGLE_CLIENT_ID and
// GOOGLE_CLIENT_SECRET (Sign in with Google), SENTRY_DSN (error reports).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "strata",
  "main": "../../apps/server/src/worker.ts",
  "compatibility_date": "2026-10-01",
  // node:crypto, node:async_hooks and process.env, which the server uses.
  "compatibility_flags": ["nodejs_compat"],
  // Cloud mode, fixed at build time: src/mode.ts reads it as modules load, before the
  // Worker's fetch handler could set STRATA_MODE.
  "define": { "STRATA_BUILD_MODE": "\"cloud\"" },
  // The dashboard, built by `bun run build` in apps/server/web; only /api/* runs the Worker.
  "assets": {
    "directory": "../../apps/server/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // TorBox sync every 15 minutes; cleanup and pruning once a day (src/worker.ts).
  "triggers": { "crons": ["*/15 * * * *", "17 4 * * *"] },
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": true },
  // The Worker answers at this address (Cloudflare makes the DNS record and certificate;
  // sehalsein.com must be a zone in the same Cloudflare account).
  "routes": [{ "pattern": "strata.sehalsein.com", "custom_domain": true }],
  "vars": {
    // Password-reset email, through Resend (RESEND_API_KEY is a secret).
    "STRATA_EMAIL_FROM": "Strata <no-reply@sehalsein.com>",
    // Also, when you're ready (see README.md):
    //   "STRATA_OPERATOR": "Sehal Sein",
    //   "STRATA_PRIVACY_CONTACT": "privacy@sehalsein.com",
    // Passkeys, Google's callback, email links and the apps' QR codes all use this address.
    "STRATA_PUBLIC_URL": "https://strata.sehalsein.com"
  }
}
