// The landing site at strata.sehalsein.com (see worker.ts). Deploy the server
// (deploy/cloudflare) first: this one binds to it.
//   bun --cwd ../../apps/landing run build
//   npx wrangler deploy
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "strata-landing",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../../apps/landing/dist",
    "binding": "ASSETS",
    // /privacy and anything else the site doesn't have as a file gets index.html.
    "not_found_handling": "single-page-application",
    // /api/* and the dashboard's old pages (worker.ts, DASHBOARD); the site's own files
    // are served without running the Worker.
    "run_worker_first": ["/api/*", "/signup*", "/overview*", "/library*", "/members*", "/devices*", "/settings*", "/backoffice*", "/logs*", "/link*", "/invite*", "/forgot-password*", "/reset-password*"]
  },
  // The cloud server (deploy/cloudflare's Worker), for /api/*.
  "services": [{ "binding": "SERVER", "service": "strata" }],
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true }, "traces": { "enabled": true, "head_sampling_rate": 0.1 } },
  "routes": [{ "pattern": "strata.sehalsein.com", "custom_domain": true }],
  "vars": { "APP_URL": "https://app.strata.sehalsein.com" }
}
