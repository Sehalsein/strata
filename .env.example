# Neon Postgres connection string
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000
ALLOW_SIGNUP=true

# TMDB API (free at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your-tmdb-v3-key

# Media + cache
MEDIA_CACHE_DIR=./.cache
MAX_CACHE_GB=20
DEFAULT_AUDIO_LANG=eng

# Optional Ollama fallback for ambiguous filenames
LLM_MATCH=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Ports
SERVER_PORT=3000
WEB_PORT=5173
