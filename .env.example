# Neon Postgres connection string
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000
ALLOW_SIGNUP=true

# TMDB API (free at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your-tmdb-v3-key

# Media + cache
MEDIA_CACHE_DIR=./.cache
MAX_CACHE_GB=20
DEFAULT_AUDIO_LANG=eng

# Optional Ollama fallback for ambiguous filenames
LLM_MATCH=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Ports
SERVER_PORT=3000
WEB_PORT=5173

# --- docker compose / production deploy ----------------------------------
# Picked up by docker-compose.yml. Safe to leave as-is for the common case.

# Host port the dockerized SPA listens on (nginx in the strata-web image).
# Named distinctly from WEB_PORT so it doesn't collide with the Vite dev port.
STRATA_WEB_PORT=8080

# Where the strata-web container reverse-proxies /jf/* to. host.docker.internal
# resolves to the Docker host (works for Jellyfin running natively on the Mac
# mini). Use http://jellyfin:8096 when running `docker compose --profile jellyfin`.
JELLYFIN_URL=http://host.docker.internal:8096

# Image tag to pull from ghcr.io/sehalsein/strata-web.
#   latest      → newest main build
#   sha-abc1234 → pin a specific commit (rollback)
#   v1.2.3      → pin a release tag
IMAGE_TAG=latest

# Only used with `--profile jellyfin`.
JELLYFIN_PORT=8096
JELLYFIN_PUBLISHED_URL=http://localhost:8096
